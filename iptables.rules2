*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

# redirect ingress traffic from port 1/2/3 to sub-namespaces
-A PREROUTING -i v-cf_p -d 172.20.0.2 -p tcp --dport 1 -j DNAT --to-destination 192.168.0.11:8080
-A PREROUTING -i v-cf_p -d 172.20.0.2 -p tcp --dport 2 -j DNAT --to-destination 192.168.0.12:8080
-A PREROUTING -i v-cf_p -d 172.20.0.2 -p tcp --dport 3 -j DNAT --to-destination 192.168.0.13:8080


# SNAT disguise egress IP address
-A POSTROUTING -d 192.168.0.0/16 -o v-cf_p -j MASQUERADE
COMMIT

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# 1. allow connected access
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -i lo -j ACCEPT

# 2. only DNAT packet allowed
-A FORWARD -i v-cf_p -p tcp --dport 8080 -m conntrack --ctstate DNAT -j ACCEPT

# 3.  reject outter access to inner networking 
# productionwise better use drop, in lab use reject
-A FORWARD -i v-cf_p -d 10.0.0.0/8 -p tcp -j REJECT --reject-with tcp-reset
-A FORWARD -i v-cf_p -d 192.168.0.0/16 -p tcp -j REJECT --reject-with tcp-reset
# fw itself is on 10.0.0.2, when called 10, it's nor forward but input
-A INPUT -i v-cf_p -d 10.0.0.0/8 -p tcp -j REJECT --reject-with tcp-reset

# 4. reject other traffics
-A FORWARD -j REJECT --reject-with icmp-port-unreachable
COMMIT
